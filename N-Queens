import java.util.*;

class Solution {
    List<List<String>> result = new ArrayList<>();
    
    public List<List<String>> solveNQueens(int n) {
        boolean[] col = new boolean[n];
        boolean[] diag = new boolean[2*n];       // r+c
        boolean[] antiDiag = new boolean[2*n];   // r-c+n

        char[][] board = new char[n][n];
        for (char[] row : board) Arrays.fill(row, '.');

        backtrack(0, board, col, diag, antiDiag, n);
        return result;
    }

    private void backtrack(int row, char[][] board,
                           boolean[] col, boolean[] diag,
                           boolean[] antiDiag, int n) {

        if (row == n) {
            List<String> list = new ArrayList<>();
            for (char[] r : board) {
                list.add(new String(r));
            }
            result.add(list);
            return;
        }

        for (int c = 0; c < n; c++) {

            if (col[c] || diag[row + c] || antiDiag[row - c + n])
                continue;

            board[row][c] = 'Q';
            col[c] = diag[row + c] = antiDiag[row - c + n] = true;

            backtrack(row + 1, board, col, diag, antiDiag, n);

            board[row][c] = '.';
            col[c] = diag[row + c] = antiDiag[row - c + n] = false;
        }
    }
}
