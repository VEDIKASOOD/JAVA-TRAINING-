class Solution {
    boolean isPalindrome(String s) {
        // code here
        return check(s, 0, s.length() - 1);
    }

    static boolean check(String s, int i, int j) {
        if (i >= j) return true;

        if (s.charAt(i) != s.charAt(j)) return false;

        return check(s, i + 1, j - 1);
    }
}
